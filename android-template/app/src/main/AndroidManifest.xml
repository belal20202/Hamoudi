<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Zero-DANGEROUS-permissions manifest (Android's protection-level
        distinction, not "zero permissions"). INTERNET and
        ACCESS_NETWORK_STATE below are both classified by Android as
        "normal" protection-level permissions; they're auto-granted at
        install time with no runtime prompt shown to the user, unlike
        "dangerous" ones (camera, location, contacts, storage, etc.), none
        of which this app requests. They're required here because the game
        now shows AdMob ads, which need network access to fetch ad content;
        that's the one thing that keeps this app from being 100% offline;
        everything else (assets, audio, save data) still works exactly as
        before with no network involved.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!--
            Required by Google Mobile Ads SDK (AdMob). Must match the App ID
            shown in your AdMob console under App settings.

            tools:replace="android:value" is required here: the Google
            Mobile Ads SDK (pulled in transitively by
            @capacitor-community/admob) bundles its OWN AndroidManifest.xml
            with a placeholder APPLICATION_ID meta-data (Google's public test
            ad app ID), so it can still initialize even if a developer
            forgets to set a real one. When our manifest declares the same
            meta-data key with our real ID, the manifest merger sees two
            different values for one attribute and fails the build unless
            explicitly told which one wins; this is that instruction.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5228365175479710~9696242750"
            tools:replace="android:value" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
